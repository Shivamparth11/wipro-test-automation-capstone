{
  "info": {
    "name": "Capstone - User API Collection",
    "description": "API tests for reqres.in demonstrating GET/POST/PUT/DELETE, status code checks, and header/body assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Single User",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://reqres.in/api/users/2",
          "protocol": "https",
          "host": ["reqres", "in"],
          "path": ["api", "users", "2"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('User id is 2', function () { var json = pm.response.json(); pm.expect(json.data.id).to.eql(2); });",
              "pm.test('Email contains @', function () { var json = pm.response.json(); pm.expect(json.data.email).to.include('@'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get User List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://reqres.in/api/users?page=2",
          "protocol": "https",
          "host": ["reqres", "in"],
          "path": ["api", "users"],
          "query": [{ "key": "page", "value": "2" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Data array is not empty', function () { var json = pm.response.json(); pm.expect(json.data.length).to.be.above(0); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Shivam\",\n  \"job\": \"QA Engineer\"\n}"
        },
        "url": {
          "raw": "https://reqres.in/api/users",
          "protocol": "https",
          "host": ["reqres", "in"],
          "path": ["api", "users"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Response has generated id', function () { var json = pm.response.json(); pm.expect(json.id).to.exist; });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Update User",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Shivam\",\n  \"job\": \"Senior QA Engineer\"\n}"
        },
        "url": {
          "raw": "https://reqres.in/api/users/2",
          "protocol": "https",
          "host": ["reqres", "in"],
          "path": ["api", "users", "2"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Job updated', function () { var json = pm.response.json(); pm.expect(json.job).to.eql('Senior QA Engineer'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Delete User",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "https://reqres.in/api/users/2",
          "protocol": "https",
          "host": ["reqres", "in"],
          "path": ["api", "users", "2"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 204', function () { pm.response.to.have.status(204); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
